# ==========================================
# SIM AI STUDIO - Environment Configuration
# ==========================================
# Generate secure secrets with: openssl rand -hex 32
# Version: 0.5.60
# ==========================================

# ==========================================
# 🔵 REQUIRED - Core Configuration
# ==========================================

# Database Configuration (PostgreSQL with pgvector)
# NOTE: DATABASE_URL will be auto-constructed from variables below
POSTGRES_USER=simdbuser2026
POSTGRES_PASSWORD=SimAiStudio
POSTGRES_DB=simstudio
POSTGRES_PORT=5433
DATABASE_URL="postgresql://simdbuser2026:SimAiStudio@db:5432/simstudio"

# Application URL and Port
APP_PORT=3001

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3001

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Security Keys (REQUIRED - Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_encryption_key_here_generate_with_openssl_rand_hex_32
INTERNAL_API_SECRET=your_internal_api_secret_here_generate_with_openssl_rand_hex_32
API_ENCRYPTION_KEY=your_api_encryption_key_here_generate_with_openssl_rand_hex_32

# ==========================================
# 🔷 OPTIONAL - Authentication & Security
# ==========================================

# Authentication Bypass (Only for private networks - NOT RECOMMENDED for production)
# DISABLE_AUTH=false

# Registration Control
# DISABLE_REGISTRATION=false
# EMAIL_PASSWORD_SIGNUP_ENABLED=true
# NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=true

# Email Restrictions (comma-separated)
# ALLOWED_LOGIN_EMAILS=user1@example.com,user2@example.com
# ALLOWED_LOGIN_DOMAINS=example.com,company.com

# Email Verification
# EMAIL_VERIFICATION_ENABLED=false

# ==========================================
# 🔷 OPTIONAL - Real-time Services
# ==========================================

# Socket.IO Configuration
SOCKET_SERVER_URL=http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
SOCKET_PORT=3002

